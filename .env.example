# Neon pooled URL. Do not use channel_binding=require with Prisma on Windows.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
AUTH_SECRET="replace-with-a-long-random-string"
# Production public URL used inside certificate QR codes (no trailing slash)
NEXT_PUBLIC_APP_URL="https://maapsetu-mauve.vercel.app"
